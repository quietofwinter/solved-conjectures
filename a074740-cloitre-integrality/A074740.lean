theorem key_fail : ¬ (prodF tauS 1834 ∣ Nat.factorial 1834 * 2 ^ 1833) := by
  rw [cum_1834]
  decide +kernel

theorem key_ok : prodF tauS 1833 ∣ Nat.factorial 1833 * 2 ^ 1832 := by
  rw [cum_1833]
  decide +kernel

theorem prod_eq (n : ℕ) (hn : n ≤ 1849) :
    ∏ k ∈ Finset.Icc 1 n, (Nat.divisors k).card = prodF tauS n := by
  rw [← prod_Icc_eq_prodF]
  apply Finset.prod_congr rfl
  intro k hk
  rw [Finset.mem_Icc] at hk
  exact card_divisors_eq_tauS k (by omega) (by omega)

end A074740

open A074740 in
/-- a(1834) = 1834! * 2^1833 / prod_{k=1..1834} tau(k) is not an integer. -/
theorem a074740_not_integer :
    ¬ ((∏ k ∈ Finset.Icc 1 1834, (Nat.divisors k).card) ∣ Nat.factorial 1834 * 2 ^ 1833) := by
  rw [prod_eq 1834 (by omega)]
  exact key_fail

open A074740 in
/-- a(1833) = 1833! * 2^1832 / prod_{k=1..1833} tau(k) is an integer. -/
theorem a074740_integer_1833 :
    (∏ k ∈ Finset.Icc 1 1833, (Nat.divisors k).card) ∣ Nat.factorial 1833 * 2 ^ 1832 := by
  rw [prod_eq 1833 (by omega)]
  exact key_ok

#print axioms a074740_integer_1833
#print axioms a074740_not_integer
