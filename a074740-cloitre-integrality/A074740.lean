/-
OEIS A074740: a(n) = n! * 2^(n-1) / prod_{k=1..n} tau(k), tau = number of divisors.
The entry (Benoit Cloitre, 2002) says "Appears to be an integer for n >= 1."

This file checks in the Lean kernel, without `native_decide`, that
  * a(1834) is not an integer (`a074740_not_integer`), and
  * a(1833) is an integer (`a074740_integer_1833`).
Only these two numerical facts are formalized; the complete classification
(a(n) is an integer iff n <= 1833 or n in {1856, 1864, 1868, 1872, ..., 1880})
is proved in the accompanying note but is not formalized here.

Method: for 0 < k <= 1849 the divisor count is rewritten as
  2 * #{d <= 43 : d | k, d^2 < k} + #{d <= 43 : d^2 = k}
(pairing d <-> k/d), and the product over k <= 1834 is evaluated by `decide +kernel`
in chunks whose values are given as numeric certificates.
-/
import Mathlib.NumberTheory.Divisors
import Mathlib.Algebra.BigOperators.Intervals


namespace A074740

open Finset

theorem card_filter_split (s : Finset ℕ) (p : ℕ → Prop) [DecidablePred p] :
    (s.filter p).card + (s.filter (fun a => ¬ p a)).card = s.card := by
  exact Finset.card_filter_add_card_filter_not p

/-- Pairing d ↔ k / d of the divisors of k. -/
theorem card_divisors_split (k : ℕ) (hk : 0 < k) :
    (Nat.divisors k).card =
      2 * ((Nat.divisors k).filter (fun d => d * d < k)).card +
        ((Nat.divisors k).filter (fun d => d * d = k)).card := by
  have h1 := card_filter_split (Nat.divisors k) (fun d => d * d < k)
  have h2 := card_filter_split ((Nat.divisors k).filter (fun d => ¬ d * d < k))
    (fun d => d * d = k)
  rw [Finset.filter_filter, Finset.filter_filter] at h2
  have hbig : ((Nat.divisors k).filter (fun d => ¬ d * d < k ∧ ¬ d * d = k)).card =
      ((Nat.divisors k).filter (fun d => d * d < k)).card := by
    apply Finset.card_nbij' (fun d => k / d) (fun d => k / d)
    · intro d hd
      simp only [Finset.coe_filter, Set.mem_setOf_eq,
        Nat.mem_divisors] at hd ⊢
      obtain ⟨⟨hdk, -⟩, hn1, hn2⟩ := hd
      have hde : d * (k / d) = k := Nat.mul_div_cancel' hdk
      refine ⟨⟨Nat.div_dvd_of_dvd hdk, hk.ne'⟩, ?_⟩
      have hgt : k < d * d := by omega
      have he : k / d < d := by
        by_contra h
        have := Nat.mul_le_mul_left d (Nat.le_of_not_lt h)
        omega
      have hepos : 0 < k / d := by
        rcases Nat.eq_zero_or_pos (k / d) with h | h
        · rw [h] at hde; omega
        · exact h
      have := Nat.mul_lt_mul_of_pos_right he hepos
      calc k / d * (k / d) < d * (k / d) := this
        _ = k := hde
    · intro d hd
      simp only [Finset.coe_filter, Set.mem_setOf_eq,
        Nat.mem_divisors] at hd ⊢
      obtain ⟨⟨hdk, -⟩, hlt⟩ := hd
      have hde : d * (k / d) = k := Nat.mul_div_cancel' hdk
      refine ⟨⟨Nat.div_dvd_of_dvd hdk, hk.ne'⟩, ?_⟩
      have he : d < k / d := by
        by_contra h
        have := Nat.mul_le_mul_left d (Nat.le_of_not_lt h)
        omega
      have : d * (k / d) < k / d * (k / d) := Nat.mul_lt_mul_of_pos_right he (by omega)
      constructor <;> omega
    · intro d hd
      simp only [Finset.coe_filter, Set.mem_setOf_eq,
        Nat.mem_divisors] at hd
      exact Nat.div_div_self hd.1.1 hk.ne'
    · intro d hd
      simp only [Finset.coe_filter, Set.mem_setOf_eq,
        Nat.mem_divisors] at hd
      exact Nat.div_div_self hd.1.1 hk.ne'
  have heq : (Nat.divisors k).filter (fun d => ¬ d * d < k ∧ d * d = k) =
      (Nat.divisors k).filter (fun d => d * d = k) := by
    apply Finset.filter_congr
    intro d _
    constructor
    · exact fun h => h.2
    · intro h; exact ⟨by omega, h⟩
  rw [heq] at h2
  omega

/-- Divisor count for 0 < k ≤ 1849 = 43², by a scan of d ≤ 43. -/
def tauS (k : ℕ) : ℕ :=
  2 * ((Finset.Icc 1 43).filter (fun d => d ∣ k ∧ d * d < k)).card +
    ((Finset.Icc 1 43).filter (fun d => d * d = k)).card

theorem small_eq (k : ℕ) (hk : 0 < k) (hk' : k ≤ 1849) :
    (Nat.divisors k).filter (fun d => d * d < k) =
      (Finset.Icc 1 43).filter (fun d => d ∣ k ∧ d * d < k) := by
  ext d
  simp only [Finset.mem_filter, Nat.mem_divisors, Finset.mem_Icc]
  constructor
  · rintro ⟨⟨hd, -⟩, hlt⟩
    refine ⟨⟨Nat.pos_of_dvd_of_pos hd hk, ?_⟩, hd, hlt⟩
    by_contra h
    have := Nat.mul_le_mul (Nat.lt_of_not_le h) (Nat.lt_of_not_le h)
    omega
  · rintro ⟨-, hd, hlt⟩
    exact ⟨⟨hd, hk.ne'⟩, hlt⟩

theorem sq_eq (k : ℕ) (hk : 0 < k) (hk' : k ≤ 1849) :
    (Nat.divisors k).filter (fun d => d * d = k) =
      (Finset.Icc 1 43).filter (fun d => d * d = k) := by
  ext d
  simp only [Finset.mem_filter, Nat.mem_divisors, Finset.mem_Icc]
  constructor
  · rintro ⟨⟨hd, -⟩, hsq⟩
    refine ⟨⟨Nat.pos_of_dvd_of_pos hd hk, ?_⟩, hsq⟩
    by_contra h
    have := Nat.mul_le_mul (Nat.lt_of_not_le h) (Nat.lt_of_not_le h)
    omega
  · rintro ⟨⟨h1, -⟩, hsq⟩
    exact ⟨⟨⟨d, hsq.symm⟩, hk.ne'⟩, hsq⟩

theorem card_divisors_eq_tauS (k : ℕ) (hk : 0 < k) (hk' : k ≤ 1849) :
    (Nat.divisors k).card = tauS k := by
  rw [card_divisors_split k hk, small_eq k hk hk', sq_eq k hk hk']
  rfl

/-- `prodF f n = f 1 * f 2 * ... * f n`. -/
def prodF (f : ℕ → ℕ) : ℕ → ℕ
  | 0 => 1
  | n + 1 => prodF f n * f (n + 1)

/-- `prodR f a c = f (a+1) * ... * f (a+c)`. -/
def prodR (f : ℕ → ℕ) (a : ℕ) : ℕ → ℕ
  | 0 => 1
  | c + 1 => prodR f a c * f (a + c + 1)

theorem prodF_add (f : ℕ → ℕ) (a c : ℕ) : prodF f (a + c) = prodF f a * prodR f a c := by
  induction c with
  | zero => simp [prodF, prodR]
  | succ c ih =>
    show prodF f (a + c) * f (a + c + 1) = prodF f a * (prodR f a c * f (a + c + 1))
    rw [ih, Nat.mul_assoc]

theorem prodF_add' (f : ℕ → ℕ) (a c b : ℕ) (h : a + c = b) :
    prodF f b = prodF f a * prodR f a c := by
  rw [← h]; exact prodF_add f a c

theorem prod_Icc_eq_prodF (f : ℕ → ℕ) (n : ℕ) :
    ∏ k ∈ Finset.Icc 1 n, f k = prodF f n := by
  induction n with
  | zero => simp [prodF]
  | succ n ih =>
    rw [Finset.prod_Icc_succ_top (by omega), ih]
    rfl

